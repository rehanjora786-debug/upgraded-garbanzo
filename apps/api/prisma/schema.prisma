generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  MANAGER
  CASHIER
  KITCHEN
}

enum OrderStatus {
  PLACED
  ACCEPTED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  ONLINE
}

enum OfferStatus {
  DRAFT
  QUEUED
  SENT
  REDEEMED
  EXPIRED
}

model Cafe {
  id          String       @id @default(cuid())
  name        String       @default("Trio Tales")
  slug        String       @unique
  phone       String       @default("9380160062")
  currency    String       @default("INR")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  users       User[]
  customers   Customer[]
  categories  MenuCategory[]
  items       MenuItem[]
  tables      CafeTable[]
  orders      Order[]
  rewards     Reward[]
  offers      Offer[]
  suppliers   Supplier[]
  stockItems  InventoryItem[]
  expenses    Expense[]
  reservations Reservation[]
  auditLogs   AuditLog[]
}

model User {
  id           String   @id @default(cuid())
  cafeId       String
  cafe         Cafe     @relation(fields: [cafeId], references: [id])
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(CASHIER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  auditLogs    AuditLog[]
  @@index([cafeId, role])
}

model Customer {
  id            String   @id @default(cuid())
  cafeId        String
  cafe          Cafe     @relation(fields: [cafeId], references: [id])
  name          String
  phone         String
  birthday      DateTime?
  marketingOptIn Boolean @default(false)
  visits        Int      @default(0)
  lastVisit     DateTime?
  favouriteItem String?
  stamps        Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  orders        Order[]
  rewards       Reward[]
  reviews       Review[]
  offers        Offer[]
  @@unique([cafeId, phone])
  @@index([cafeId, lastVisit])
}

model MenuCategory {
  id        String     @id @default(cuid())
  cafeId    String
  cafe      Cafe       @relation(fields: [cafeId], references: [id])
  name      String
  sortOrder Int        @default(0)
  items     MenuItem[]
  @@unique([cafeId, name])
}

model MenuItem {
  id          String       @id @default(cuid())
  cafeId      String
  cafe        Cafe         @relation(fields: [cafeId], references: [id])
  categoryId  String?
  category    MenuCategory? @relation(fields: [categoryId], references: [id])
  name        String
  description String?      @db.Text
  pricePaise  Int
  imageUrl    String?
  available   Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  orderItems  OrderItem[]
  @@index([cafeId, available])
}

model CafeTable {
  id        String   @id @default(cuid())
  cafeId    String
  cafe      Cafe     @relation(fields: [cafeId], references: [id])
  label     String
  qrToken   String   @unique
  active    Boolean  @default(true)
  orders    Order[]
  @@unique([cafeId, label])
}

model Order {
  id          String      @id @default(cuid())
  cafeId      String
  cafe        Cafe        @relation(fields: [cafeId], references: [id])
  customerId  String?
  customer    Customer?   @relation(fields: [customerId], references: [id])
  tableId     String?
  table       CafeTable?  @relation(fields: [tableId], references: [id])
  status      OrderStatus @default(PLACED)
  subtotalPaise Int
  taxPaise    Int         @default(0)
  totalPaise  Int
  notes       String?     @db.Text
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  items       OrderItem[]
  payment     Payment?
  @@index([cafeId, createdAt])
  @@index([cafeId, status])
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id])
  menuItemId     String?
  menuItem       MenuItem? @relation(fields: [menuItemId], references: [id])
  itemName       String
  unitPricePaise Int
  quantity       Int
  lineTotalPaise Int
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String        @unique
  order             Order         @relation(fields: [orderId], references: [id])
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  amountPaise       Int
  providerReference String?
  verifiedAt        DateTime?
  createdAt         DateTime      @default(now())
}

model Reward {
  id          String   @id @default(cuid())
  cafeId      String
  cafe        Cafe     @relation(fields: [cafeId], references: [id])
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  code        String
  description String
  redeemedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  @@unique([cafeId, code])
  @@index([customerId, redeemedAt])
}

model Review {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  rating      Int
  comment     String?  @db.Text
  createdAt   DateTime @default(now())
}

model Offer {
  id          String      @id @default(cuid())
  cafeId      String
  cafe        Cafe        @relation(fields: [cafeId], references: [id])
  customerId  String
  customer    Customer    @relation(fields: [customerId], references: [id])
  title       String
  message     String      @db.Text
  status      OfferStatus @default(DRAFT)
  sentAt      DateTime?
  redeemedAt  DateTime?
  createdAt   DateTime    @default(now())
  @@index([cafeId, status, createdAt])
}

model Supplier {
  id        String   @id @default(cuid())
  cafeId    String
  cafe      Cafe     @relation(fields: [cafeId], references: [id])
  name      String
  phone     String?
  items     InventoryItem[]
}

model InventoryItem {
  id              String   @id @default(cuid())
  cafeId          String
  cafe            Cafe     @relation(fields: [cafeId], references: [id])
  supplierId      String?
  supplier        Supplier? @relation(fields: [supplierId], references: [id])
  name            String
  unit            String
  quantity        Decimal  @default(0) @db.Decimal(10, 2)
  lowStockAt      Decimal  @default(0) @db.Decimal(10, 2)
  costPerUnitPaise Int     @default(0)
  updatedAt       DateTime @updatedAt
  @@unique([cafeId, name])
}

model Expense {
  id          String   @id @default(cuid())
  cafeId      String
  cafe        Cafe     @relation(fields: [cafeId], references: [id])
  title       String
  amountPaise Int
  spentAt     DateTime @default(now())
  notes       String?  @db.Text
}

model Reservation {
  id          String   @id @default(cuid())
  cafeId      String
  cafe        Cafe     @relation(fields: [cafeId], references: [id])
  customerName String
  phone       String
  partySize   Int
  reservedFor DateTime
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  cafeId    String
  cafe      Cafe     @relation(fields: [cafeId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  details   String?  @db.Text
  createdAt DateTime @default(now())
  @@index([cafeId, createdAt])
}
